<Application
    x:Class="PhoneMic.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhoneMic.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <views:BoolToVisConverter x:Key="BoolNegationConverter" Negate="True"/>
            <views:BoolToVisConverter x:Key="BoolToVisConverter"/>
            <views:MuteLabelConverter x:Key="MuteLabelConverter"/>
            <views:ActiveLabelConverter x:Key="ActiveLabelConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
