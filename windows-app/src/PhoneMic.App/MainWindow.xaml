<Window
    x:Class="PhoneMic.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PhoneMic.App.Views"
    Title="PhoneMic">
    <Grid>
        <NavigationView x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Панель" Tag="dashboard" Icon="Play"/>
                <NavigationViewItem Content="Подключение" Tag="connect" Icon="People"/>
                <NavigationViewItem Content="Транспорт" Tag="transport" Icon="Share"/>
                <NavigationViewItem Content="Аудио" Tag="audio" Icon="Audio"/>
                <NavigationViewItem Content="Безопасность" Tag="security" Icon="ProtectSettings"/>
                <NavigationViewItem Content="Драйвер" Tag="driver" Icon="System"/>
                <NavigationViewItem Content="Журнал" Tag="logs" Icon="Document"/>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
