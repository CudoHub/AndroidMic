<Page
    x:Class="PhoneMic.App.Views.DriverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Драйвер" FontSize="28" FontWeight="SemiBold"/>

            <InfoBar x:Name="DriverInfoBar" IsOpen="True" Severity="Warning"
                     Title="PhoneMic Virtual Microphone"
                     Message=""/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Состояние" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StateText" Text="—" FontFamily="Consolas" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Обновить" Click="Refresh_Click"/>
                        <Button Content="Сбросить буфер (FLUSH)" Click="Flush_Click"/>
                        <Button Content="Установить драйвер…" Click="Install_Click"/>
                        <Button Content="Удалить драйвер…" Click="Uninstall_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Как установить драйвер" FontWeight="SemiBold"/>
                    <TextBlock FontFamily="Consolas" TextWrapping="Wrap"
                               Text="1. Соберите/распакуйте пакет драйвера (phonemic.sys + phonemic.inf + phonemic.cat).&#x0a;2. Для тестовой подписи (без сертификата): от администратора&#x0a;    bcdedit /set testsigning on   и перезагрузите ПК.&#x0a;3. Установка (от администратора):&#x0a;    devcon install phonemic.inf Root\PhoneMic&#x0a;   или через скрипт scripts\install_driver.ps1 из репозитория.&#x0a;4. Устройство появится как «PhoneMic Virtual Microphone» в звуковых устройствах."/>
                    <TextBlock Text="Кнопка «Установить драйвер…» пытается запустить установку через pnputil/devcon — потребуется подтверждение UAC."
                               TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
